# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# runtime-written admin credentials (data/admin-credentials.json) — see
# src/lib/adminAuth.ts. Never commit; this is a secret, generated locally.
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large/duplicate PDFs not used by the app
# The display PDF (public/Assets/UFirm_Newsletter-2025-26.pdf) IS committed.
# This file is a leftover duplicate — keep it out of the repo.
/public/AR2025-26_compressed*.pdf
/public/Assets/AR2025-26*.pdf
.claude